# ============================================================
# 啟動前請複製此檔案為 .env 並填入你的設定
# cp .env.example .env
# ============================================================

# --- Groq API ---
# 免費申請：https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Telegram Bot ---
# 向 @BotFather 申請 Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 你的 Telegram User ID（向 @userinfobot 查詢）
TELEGRAM_ALLOWED_USER_IDS=your_telegram_user_id_here

# --- 瀏覽器設定 ---
# Chrome 遠端除錯 Port（啟動 Chrome 時加 --remote-debugging-port=9222）
CHROME_DEBUG_PORT=9222
# OpenCLI Browser Bridge Port
BROWSER_BRIDGE_PORT=19825

# --- 檔案系統 ---
# AI 輸出的根目錄（報告、截圖、爬取資料都存在這裡）
OUTPUT_BASE_PATH=~/ai_output
# 額外允許 AI 存取的資料夾（用逗號分隔）
EXTRA_ALLOWED_PATHS=~/Desktop,~/Documents/ai_reports

# --- 時區 ---
TIMEZONE=Asia/Taipei
